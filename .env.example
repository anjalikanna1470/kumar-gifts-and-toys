# Kumar Gifts & Toys Environment Variables Template
# Copy this file to .env on your server and fill in production values.

# Server Port
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# Frontend API URL (Used by React frontend to connect to production Node/Express API)
# Development example: VITE_API_URL=http://localhost:5000
# Production example: VITE_API_URL=https://api.kumargiftsandtoys.in
VITE_API_URL=

# Allowed Client Origin for CORS (GitHub Pages or Custom Domain)
# Example: CLIENT_ORIGIN=https://anjalikanna1470.github.io
CLIENT_ORIGIN=https://anjalikanna1470.github.io

# Cryptographically random secret key for JWT token signing (REQUIRED in production)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# First-time initial Admin Account Credentials (Used ONLY on initial database creation)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
