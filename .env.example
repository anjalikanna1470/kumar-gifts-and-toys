# ==========================================
# KUMAR GIFTS & TOYS — PRODUCTION ENV TEMPLATE
# ==========================================

# Server Port
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# Cryptographically random secret key for JWT token signing (REQUIRED in production)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# First-time initial Admin Account Credentials (Used ONLY on initial database creation)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
